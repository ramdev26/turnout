{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/**/*.php": {
      "runtime": "vercel-php@0.7.3",
      "includeFiles": "{cpanel/api/**,.env}"
    }
  },
  "routes": [
    {
      "src": "^/api/(.*)$",
      "dest": "/api/index.php"
    },
    {
      "src": "^/t/([A-Za-z0-9]+)/?$",
      "dest": "/api/index.php"
    },
    {
      "src": "^/e/([^/?#]+)/?$",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(whatsapp|facebookexternalhit|facebot|twitterbot|linkedinbot|slackbot|discordbot|telegrambot|skypeuripreview|googlebot|bingbot|embedly|quora link preview|pinterest|redditbot|applebot).*"
        }
      ],
      "dest": "/api/index.php?share_slug=$1"
    },
    {
      "src": "^/landing$",
      "dest": "/turnout-landing.html"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "^/(.*)$",
      "dest": "/index.html"
    }
  ]
}
