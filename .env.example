# Frontend (Vite) — optional if API is on another domain
# VITE_API_BASE_URL=https://your-api.example

# Backend (Vercel / server env) — see cpanel/api/config.php pattern
# DATABASE_URL=postgres://...
# SESSION_TOKEN_SECRET=long-random-secret
# BLOB_READ_WRITE_TOKEN=vercel-blob-token
# APP_BASE_URL=https://your-app.vercel.app
# PAYHERE_MERCHANT_ID=
# PAYHERE_MERCHANT_SECRET=
# PAYHERE_NOTIFY_URL=https://your-app.vercel.app/api/payhere/notify
# PAYHERE_SANDBOX=true

# Custom domains (Vercel)
# CUSTOM_DOMAIN_CNAME_TARGET=cname.vercel-dns.com
# CUSTOM_DOMAIN_APEX_IP=76.76.21.21
# PLATFORM_HOSTS=turnout-omega.vercel.app,localhost,127.0.0.1
# VERCEL_API_TOKEN=
# VERCEL_PROJECT_ID=
# VERCEL_TEAM_ID=
