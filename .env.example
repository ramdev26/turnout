# Frontend (Vite) — optional if API is on another domain
# VITE_API_BASE_URL=https://your-api.example

# Google Places — see committed `.env` for the project key (or override locally in .env.local)
# VITE_GOOGLE_MAPS_API_KEY=

# Plunk transactional email (PHP API — order confirmations; use SECRET key only)
# PLUNK_SECRET_KEY=sk_your_plunk_secret_key
# PLUNK_PUBLIC_KEY=pk_your_plunk_public_key
# PLUNK_API_URL=https://next-api.useplunk.com/v1/send
# MAIL_ENABLED=true
# MAIL_FROM=admin@bigturnout.co
# MAIL_FROM_NAME=Turnout

# Backend (Vercel / server env) — see cpanel/api/config.php pattern
# DATABASE_URL=postgres://...
# SESSION_TOKEN_SECRET=long-random-secret
# BLOB_READ_WRITE_TOKEN=vercel-blob-token
# APP_BASE_URL=https://your-app.vercel.app
# PAYHERE_MERCHANT_ID=
# PAYHERE_MERCHANT_SECRET=
# PAYHERE_NOTIFY_URL=https://your-app.vercel.app/api/payhere/notify
# PAYHERE_SANDBOX=true

# Custom domains (Vercel)
# CUSTOM_DOMAIN_CNAME_TARGET=cname.vercel-dns.com
# CUSTOM_DOMAIN_APEX_IP=76.76.21.21
# PLATFORM_HOSTS=turnout-omega.vercel.app,localhost,127.0.0.1
# VERCEL_API_TOKEN=
# VERCEL_PROJECT_ID=
# VERCEL_TEAM_ID=
