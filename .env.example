# Frontend (Vite) — optional if API is on another domain
# VITE_API_BASE_URL=https://your-api.example

# Google Places — browser key (Maps JavaScript API + Places API legacy)
# Set both so Vite build AND runtime /api/public/config can serve the key on Vercel.
# VITE_GOOGLE_MAPS_API_KEY=
# GOOGLE_MAPS_API_KEY=

# Plunk transactional email (PHP API — order confirmations; use SECRET key only)
# PLUNK_SECRET_KEY=sk_your_plunk_secret_key
# PLUNK_PUBLIC_KEY=pk_your_plunk_public_key
# PLUNK_API_URL=https://next-api.useplunk.com/v1/send
# MAIL_ENABLED=true
# MAIL_FROM=admin@bigturnout.co
# MAIL_FROM_NAME=Turnout

# SMSlenz transactional SMS (order confirmations — server only)
# SMS_ENABLED=true
# SMSLENZ_USER_ID=
# SMSLENZ_API_KEY=
# SMSLENZ_SENDER_ID=TURNOUT
# SMSLENZ_API_BASE_URL=https://smslenz.lk/api

# Backend (Vercel / server env) — see cpanel/api/config.php pattern
# DATABASE_URL=postgres://...
# SESSION_TOKEN_SECRET=long-random-secret
# SUPER_ADMIN_EMAIL=admin@bigturnout.co
# SUPER_ADMIN_PASSWORD=BigTurnout@Admin2026!
# SUPER_ADMIN_BOOTSTRAP=true
# BLOB_READ_WRITE_TOKEN=vercel-blob-token
# APP_BASE_URL=https://app.bigturnout.co
# VITE_APP_BASE_URL=https://app.bigturnout.co
# PAYHERE_MERCHANT_ID=
# PAYHERE_MERCHANT_SECRET=
# PAYHERE_NOTIFY_URL=https://app.bigturnout.co/api/payhere/notify
# PayHere runs live-only; the merchant secret must be the one issued for the
# exact domain that serves checkout (subdomains are approved separately).

# Custom domains (Vercel)
# CUSTOM_DOMAIN_CNAME_TARGET=cname.vercel-dns.com
# CUSTOM_DOMAIN_APEX_IP=76.76.21.21
# PLATFORM_HOSTS=app.bigturnout.co,turnout-omega.vercel.app,localhost,127.0.0.1
# VERCEL_API_TOKEN=
# VERCEL_PROJECT_ID=
# VERCEL_TEAM_ID=
