# Copy this file to `.env.local` for local development if needed.
# (The PHP/MySQL API is configured separately in `cpanel/api/config.php` on cPanel.)
# Optional: use hosted API when local PHP is unavailable.
# Example: VITE_API_BASE_URL=https://your-domain.com
# Leave empty to use Vite proxy (/api -> http://127.0.0.1:8000 in dev).
# For Vercel production, set this in Project Settings -> Environment Variables.
VITE_API_BASE_URL=
