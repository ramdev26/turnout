# Copy to `.env` in this folder (or repo root) before `docker compose up`.
# docker compose reads this file automatically if named `.env` next to the compose file.

APP_BASE_URL=http://localhost
PLATFORM_HOSTS=localhost,127.0.0.1

DB_DRIVER=mysql
DB_HOST=db
DB_NAME=turnout
DB_USER=turnout
DB_PASS=change-me-strong-password
DB_ROOT_PASS=change-me-root-password
DB_CHARSET=utf8mb4

SESSION_TOKEN_SECRET=replace-with-32-plus-random-chars
SESSION_COOKIE_SECURE=false
APP_DEV_MODE=false
APP_DEBUG=false

PAYHERE_SANDBOX=true
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
PAYHERE_NOTIFY_URL=http://localhost/api/payhere/notify

MAIL_ENABLED=false
PLUNK_SECRET_KEY=
MAIL_FROM=admin@bigturnout.co
MAIL_FROM_NAME=Turnout

# Optional HTTPS via Caddy (set to your domain, e.g. app.example.com)
# APP_DOMAIN=
